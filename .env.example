# ============================================================================
# Fisioterapia Online con Adela — Variables de entorno
# ----------------------------------------------------------------------------
# 1. Copia este fichero a `.env` (cp .env.example .env) y rellena los valores.
# 2. `.env` está en .gitignore: NUNCA se sube al repositorio.
# 3. En producción, las claves se configuran en el panel del proveedor
#    (Vercel / VPS / Supabase secrets), no en ficheros.
# 4. Prefijo PUBLIC_: puede llegar al navegador. Sin prefijo: solo servidor.
#
# ⚠️  Lista provisional basada en la demo. Se ajusta al cerrar specs/01-stack.md.
# ============================================================================

# --- Entorno -----------------------------------------------------------------
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de datos, auth, almacenamiento de vídeos) ---------------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor / Edge Functions. Salta el RLS: jamás en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# --- Zernio (WhatsApp / Instagram omnicanal) ---------------------------------
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# --- Google Workspace (Calendar + Meet) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=

# --- Email transaccional (confirmaciones, recordatorios) ---------------------
RESEND_API_KEY=
EMAIL_FROM="Fisioterapia Online con Adela <hola@dominio-pendiente.es>"

# --- Pagos (pendiente de decidir: Stripe / Bizum / transferencia) -----------
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Datos de contacto de la clínica ----------------------------------------
PUBLIC_CLINIC_PHONE=
PUBLIC_CLINIC_WHATSAPP=
PUBLIC_CLINIC_EMAIL=
